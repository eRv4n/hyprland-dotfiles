{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",

  "control-center-margin-top": 6,
  "control-center-margin-right": 6,
  "control-center-margin-bottom": 10,

  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-window-width": 400,

  "control-center-width": 375,
  "control-center-height": 700,
  "fit-to-screen": false,
  "timeout": 10,
  "timeout-low": 2,
  "timeout-critical": 0,
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",

  "widgets": ["buttons-grid", "mpris", "volume", "backlight", "notifications"],

  "widget-config": {
    "backlight": {
      "label": "󰃟",
      "device": "amdgpu_bl1",
      "min": 5
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "active": true,
          "command": "bash -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update_command": "bash -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": false,
          "command": "bash -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
          "update_command": "bash -c '[[ $(bluetoothctl show | grep Powered | cut -d\" \" -f2) == \"yes\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂛",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d -sw",
          "update_command": "swaync-client -D -sw"
        },
        {
          "label": "󰌾",
          "command": "bash -c 'swaync-client -cp -sw; sleep 0.3; hyprlock'"
        },
        {
          "label": "󰩹",
          "command": "bash -c 'swaync-client -cp -sw; xdg-open trash:///'"
        }
      ]
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    }
  },
  "scripts": {
    "normal": {
      "exec": "paplay /usr/share/sounds/freedesktop/stereo/message.oga",
      "urgency": "Normal"
    },
    "critical": {
      "exec": "paplay /usr/share/sounds/freedesktop/stereo/bell.oga",
      "urgency": "Critical"
    }
  }
}
